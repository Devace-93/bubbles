# Variables the API reads. Locally, compose.yaml already sets them for the
# containers; this file documents them for Railway (and for running outside
# Docker, in which case copy it to api/.env — gitignored).

# Postgres connection string. Railway injects its own DATABASE_URL.
DATABASE_URL=postgresql://bubbles:bubbles@localhost:5433/bubbles

# Separate database used by pytest; tables are truncated between tests.
TEST_DATABASE_URL=postgresql://bubbles:bubbles@localhost:5433/bubbles_test

# Identity service (accounts.3m4.net). The API verifies its session cookie /
# bearer JWT against ${ACCOUNTS_INTERNAL_URL}/.well-known/jwks.json; the
# issuer claim must equal ACCOUNTS_URL. Production: https://accounts.3m4.net
# for both. Local compose: http://localhost:8085 and http://accounts-api-1:5000.
ACCOUNTS_URL=http://localhost:8085
ACCOUNTS_INTERNAL_URL=http://localhost:8085

# Comma-separated allowlist of browser origins.
CORS_ORIGINS=https://bubbles.3m4.net,http://localhost:5173,http://localhost:4323

# Port gunicorn binds to. Railway sets PORT itself.
PORT=8000
