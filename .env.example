# Copy this file to .env for local overrides.
# .env is gitignored — put real secrets there, never in this file.

# Canonical site origin used in Open Graph tags and the share URL (no trailing slash).
VITE_SITE_URL=https://bubbles.3m4.net

# 3m4 apps index site linked from the footer (no trailing slash).
VITE_INFO_URL=https://info.3m4.net

# accounts.3m4.net: the session widget (session.js) and the hosted login pages.
# Login is optional; a valid session saves scores online. Local stack: http://localhost:8085
VITE_ACCOUNTS_URL=https://accounts.3m4.net
# Bubbles API (api/): online scores + leaderboard. Local: http://localhost:8000
VITE_API_URL=https://api.bubbles.3m4.net

# Port for the legacy dev server (legacy/scripts/serve.ts).
PORT=8015

# ElevenLabs key for `bun run voices` (announcer clips). Build-time only —
# never read by client code. Set the real value in .env only.
#ELEVENLABS_API_KEY=
# Optional: override the voice for every locale, or one locale (e.g. _ES_MX).
#ELEVENLABS_VOICE_ID=
#ELEVENLABS_VOICE_ID_ES_MX=
